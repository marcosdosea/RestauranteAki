@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var isHomePage = controller == "Home" && action == "Index";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestauranteAkiWeb</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestauranteAkiWeb.styles.css" asp-append-version="true" />
</head>
<body class="@(isHomePage ? "home-page" : "")">

    <div id="sidebar-trigger">
        <i class="fa-solid fa-bars"></i>
    </div>

    <aside class="sidebar">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index" style="text-decoration: none; display: flex; align-items: center;">
                <span class="logo-icon">R</span><span class="logo-text">estauranteAki</span>
            </a>
        </div>
        <nav>
            <ul>
                <li><a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i> Home</a></li>
                <li><a asp-area="" asp-controller="Restaurante" asp-action="Index"><i class="fa-solid fa-utensils"></i> Restaurante</a></li>
                <li><a asp-area="" asp-controller="Pessoa" asp-action="Index"><i class="fa-solid fa-user"></i> Pessoa</a></li>
                <li><a asp-area="" asp-controller="Garcom" asp-action="Index"><i class="fa-solid fa-user-tie"></i> Garcom</a></li>
                <li><a asp-area="" asp-controller="Itemcardapio" asp-action="Index"><i class="fa-solid fa-book-open"></i> Itemcardapio</a></li>
                <li><a asp-area="" asp-controller="Cardapio" asp-action="Index"><i class="fa-solid fa-book"></i>Cardapio</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Privacy"><i class="fa-solid fa-shield-halved"></i> Privacy</a></li>
            </ul>
        </nav>
    </aside>

    <main class="main-content">
        @if (!isHomePage)

        {
            <div class="main-header-wrapper">
                <header class="main-header">
                    <h1 id="main-title">@ViewData["Title"]</h1>
                </header>
            </div>
        }

        <div class="container-fluid px-4 h-100">
            @RenderBody()
        </div>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>