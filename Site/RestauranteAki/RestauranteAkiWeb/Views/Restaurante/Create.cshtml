@model RestauranteAkiWeb.Models.RestauranteViewModel

@{
    ViewData["SubTitle"] = "Adicionar Restaurante";
    
}

@section Styles {
        <link rel="stylesheet" href="~/css/restaurante-styles.css" />
}

<div class="container-fluid my-5">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="glass-card" data-aos="fade-up">
                <div class="card-header-custom">
                    <div class="logo-box">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <span class="header-title">@ViewData["SubTitle"]</span>
                </div>
                <div class="card-body card-body-custom">

                    <form asp-action="Create" method="post">
                         <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="mb-0">Informações do Restaurante</h4>
                            <div>
                                <a asp-action="Index" class="btn btn-danger btn-animated">
                                    <i class="fas fa-arrow-left me-2"></i> Voltar
                                </a>
                                <button type="submit" class="btn btn-green btn-animated">
                                    <i class="fas fa-save me-2"></i> Salvar
                                </button>
                            </div>
                        </div>
                        <hr/>

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nome" class="form-label fw-semibold"></label>
                                <input asp-for="Nome" class="form-control" />
                                <span asp-validation-for="Nome" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NomeFantasia" class="form-label fw-semibold"></label>
                                <input asp-for="NomeFantasia" class="form-control" />
                                <span asp-validation-for="NomeFantasia" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cnpj" class="form-label fw-semibold"></label>
                                <input asp-for="Cnpj" class="form-control" />
                                <span asp-validation-for="Cnpj" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cep" class="form-label fw-semibold"></label>
                                <input asp-for="Cep" class="form-control" id="cep-input" />
                                <span asp-validation-for="Cep" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Logradouro" class="form-label fw-semibold"></label>
                            <input asp-for="Logradouro" class="form-control" id="rua-input" />
                            <span asp-validation-for="Logradouro" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="Numero" class="form-label fw-semibold"></label>
                                <input asp-for="Numero" class="form-control" />
                                <span asp-validation-for="Numero" class="text-danger"></span>
                            </div>
                            <div class="col-md-9 mb-3">
                                <label asp-for="Bairro" class="form-label fw-semibold"></label>
                                <input asp-for="Bairro" class="form-control" id="bairro-input" />
                                <span asp-validation-for="Bairro" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-9 mb-3">
                                <label asp-for="Cidade" class="form-label fw-semibold"></label>
                                <input asp-for="Cidade" class="form-control" id="cidade-input" />
                                <span asp-validation-for="Cidade" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Estado" class="form-label fw-semibold"></label>
                                <input asp-for="Estado" class="form-control" id="estado-input" />
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Complemento" class="form-label fw-semibold"></label>
                            <input asp-for="Complemento" class="form-control" />
                            <span asp-validation-for="Complemento" class="text-danger"></span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.body.classList.add('bg-animated');
    </script>
    <script src="~/js/cadastro-restaurante.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}