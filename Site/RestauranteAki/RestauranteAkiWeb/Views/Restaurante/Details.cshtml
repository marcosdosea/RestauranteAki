@model RestauranteAkiWeb.Models.RestauranteViewModel

@{
    ViewData["Title"] = "Detalhes do Restaurante";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a></div>
            <div><a class="btn btn-secondary" onclick="history.back();">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Restaurante</div>
        <div class="row">
            <div class="col-12">
                <div class="item-card">
                    <div class="item-info">
                        <div class="item-restaurante-detail">
                            <strong>Id:</strong> @Model.Id
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Nome:</strong> @Model.Nome
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Nome Fantasia:</strong> @Model.NomeFantasia
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>CNPJ:</strong> @Model.Cnpj
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>CEP:</strong> @Model.Cep
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Logradouro:</strong> @Model.Logradouro
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Bairro:</strong> @Model.Bairro
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Cidade:</strong> @Model.Cidade
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Estado:</strong> @Model.Estado
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Complemento:</strong> @Model.Complemento
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    @@media (min-width: 768px) {
        .item-info {
            flex-direction: column;
            align-items: flex-start;
            margin-left: 2rem;
        }
    }
</style>
