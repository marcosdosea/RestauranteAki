@model RestauranteAkiWeb.Models.RestauranteViewModel

@{
    ViewData["SubTitle"] = "Excluir Restaurante";

}

@section Styles {
    <link rel="stylesheet" href="~/css/restaurante-styles.css" />
   
}

<div class="container-fluid - my-5">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="glass-card" data-aos="fade-up">
                <div class="card-header-custom bg-danger">
                    <div class="logo-box" style="background: rgba(255,255,255,0.1);">
                        <i class="fas fa-trash-alt"></i>
                    </div>
                    <span class="header-title">@ViewData["SubTitle"]</span>
                </div>
                <div class="card-body card-body-custom">

                    <div class="alert alert-danger text-center">
                        <h4 class="alert-heading">Atenção!</h4>
                        <p class="mb-0">Tem certeza que deseja excluir permanentemente o restaurante abaixo? Esta ação não pode ser recuperada.</p>
                    </div>

                    <hr />

                    <h5 class="mt-4 mb-3">Detalhes do Restaurante:</h5>

                    <dl class="row details-list">
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nome)</dt>
                        <dd class="col-sm-9">@Model.Nome</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.NomeFantasia)</dt>
                        <dd class="col-sm-9">@Model.NomeFantasia</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Cnpj)</dt>
                        <dd class="col-sm-9">@Model.Cnpj</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Cep)</dt>
                        <dd class="col-sm-9">@Model.Cep</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Logradouro)</dt>
                        <dd class="col-sm-9">@Model.Logradouro</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Numero)</dt>
                        <dd class="col-sm-9">@Model.Numero</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Bairro)</dt>
                        <dd class="col-sm-9">@Model.Bairro</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Cidade)</dt>
                        <dd class="col-sm-9">@Model.Cidade</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Estado)</dt>
                        <dd class="col-sm-9">@Model.Estado</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Complemento)</dt>
                        <dd class="col-sm-9">@Model.Complemento</dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger btn-animated">
                                <i class="fas fa-trash-alt me-2"></i>Confirmar Exclusão
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-animated">Cancelar</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.body.classList.add('bg-animated');
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}