@model RestauranteAkiWeb.Models.RestauranteViewModel

@{
    ViewData["Title"] = "Excluir Restaurante";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Tem certeza que deseja excluir?');">
                <button type="submit" class="btn btn-danger">Excluir</button>
            </form>
            <div>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Excluir Restaurante</div>
        <div class="row">
            <div class="col-12">
                <div class="delete-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Atenção!</strong> Você tem certeza que deseja excluir permanentemente o restaurante abaixo?
                </div>

                <div class="item-card">
                    <div class="item-info">
                        <div class="item-restaurante-detail">
                            <strong>Nome:</strong> @Model.Nome
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>CNPJ:</strong> @Model.Cnpj
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>CEP:</strong> @Model.Cep
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Logradouro:</strong> @Model.Logradouro
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Bairro:</strong> @Model.Bairro
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Cidade:</strong> @Model.Cidade
                        </div>
                        <div class="item-restaurante-detail">
                            <strong>Estado:</strong> @Model.Estado
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    @@media (min-width: 768px) {
        .item-info {
            flex-direction: column;
            align-items: flex-start;
            margin-left: 2rem;
        }
    }
</style>