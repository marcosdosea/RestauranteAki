@model RestauranteAkiWeb.Models.RestauranteViewModel

@{
    ViewData["Title"] = "Painel – Exclusão de Restaurante";
}

@section Styles {
    <link rel="stylesheet" href="~/css/list-style.css" />
}

<div class="list-wrapper">
    <form asp-action="Delete">

        <div class="header-bar form-header">
            <h2>Confirmar Exclusão</h2>

            <div class="header-actions">
                <button type="submit" class="btn-custom-danger">
                    <i class="bi bi-trash3-fill"></i> Sim, Excluir
                </button>
                <a asp-action="Index" class="btn-custom-tertiary">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
            </div>
        </div>

        <div class="list-container" style="padding: 30px;">

            <input type="hidden" asp-for="Id" />

            <div class="delete-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Atenção!</strong> Você tem certeza que deseja excluir permanentemente o restaurante abaixo?
            </div>

            <dl class="row details-list">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.NomeFantasia)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NomeFantasia)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Cnpj)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Cnpj)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Cep)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Cep)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Bairro)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Bairro)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Cidade)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Cidade)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Estado)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Estado)
                </dd>
            </dl>

        </div>
    </form>
</div>