@model IEnumerable<RestauranteAkiWeb.Models.RestauranteViewModel>

@{
    ViewData["SubTitle"] = "Painel de Restaurantes";

}

@section Styles {
    
    <link rel="stylesheet" href="~/css/restaurante-styles.css" />
}

<div class="container-fluid - my-5">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="glass-card" data-aos="fade-up">
                <div class="card-header-custom">
                    <div class="logo-box">
                        <i class="fas fa-store"></i>
                    </div>
                    <span class="header-title">@ViewData["SubTitle"]</span>
                </div>
                <div class="card-body card-body-custom">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0">Lista de Restaurantes</h4>
                        <div>
                            <a asp-action="Create" class="btn btn-green btn-animated">
                                <i class="fas fa-plus me-2"></i>Adicionar Novo
                            </a>
                        </div>
                    </div>

                    <div class="list-container bg-white rounded-3 shadow-sm">
                        @if (Model.Any())

                        {
                            @foreach (var item in Model)

                            {
                                <div class="list-item-card">
                                    <div class="item-avatar"><i class="fas fa-utensils"></i></div>
                                    <div class="item-info">
                                        <div class="item-nomefantasia">@item.NomeFantasia</div>
                                        <small class="text-muted">ID: @item.Id | CNPJ: @item.Cnpj</small>
                                    </div>

                                    <div class="item-actions">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-secondary-to-primary">
                                            <i class="fas fa-pencil-alt me-2"></i>Editar
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-secondary-to-info">
                                            <i class="fas fa-search me-2"></i>Detalhes
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-secondary btn-secondary-to-danger">
                                            <i class="fas fa-trash-alt me-2"></i>Deletar
                                        </a>
                                    </div>

                                </div>
                            }
                        }

                        else

                        {
                            <div class="text-center p-5">
                                <p>Nenhum restaurante cadastrado ainda.</p>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.body.classList.add('bg-animated');
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}