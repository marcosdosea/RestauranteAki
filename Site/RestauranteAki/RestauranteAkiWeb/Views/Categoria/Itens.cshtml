@model IEnumerable<RestauranteAkiWeb.Models.ItemcardapioViewModel>

@{
    ViewData["Title"] = "Cardapio";
}

<div>


    <section class="card-list-section">
        <div class="card-list-header">Cardapio</div>
        <div class="card-list">
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="person-card">
                        <img class="person-avatar"
                             src="/avatar-default.jpg"
                     alt="Foto de @item.Nome" />
                <div class="person-info">
                    <span class="person-name">@item.Nome</span>
                </div>
                <div class="person-actions">
                    <a asp-action="Edit" asp-controller="itemcardapio" asp-route-id="@item.Id" class="btn btn-primary">Editar</a>
                    <a asp-action="Details" asp-controller="itemcardapio" asp-route-id="@item.Id" class="btn btn-primary">Detalhes</a>
                    <a asp-action="Delete" asp-controller="itemcardapio" asp-route-id="@item.Id" class="btn btn-danger">Deletar</a>
                </div>
            </div>
                        }
            }
            else
            {
                <p class="no-data">Nenhum Cardapio cadastrado.</p>
            }
        </div>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" />
}
