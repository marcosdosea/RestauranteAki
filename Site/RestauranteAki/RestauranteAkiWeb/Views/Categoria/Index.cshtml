

<div class="container">
    <h1 class="page-title">Nosso Menu</h1>

    <div class="categories-grid">
        <!-- Hambúrgueres -->
        <a href="/categoria/1" class="category-card">
            <svg class="category-icon" viewBox="0 0 100 100" fill="none">
                <!-- Pão Superior -->
                <ellipse cx="50" cy="25" rx="35" ry="12" fill="#D2691E" stroke="#8B4513" stroke-width="1" />
                <!-- Sementes no pão -->
                <circle cx="40" cy="25" r="1.5" fill="#8B4513" />
                <circle cx="50" cy="23" r="1.5" fill="#8B4513" />
                <circle cx="60" cy="25" r="1.5" fill="#8B4513" />
                <circle cx="45" cy="27" r="1.5" fill="#8B4513" />
                <circle cx="55" cy="27" r="1.5" fill="#8B4513" />

                <!-- Alface -->
                <ellipse cx="50" cy="35" rx="32" ry="8" fill="#32CD32" />

                <!-- Hambúrguer -->
                <ellipse cx="50" cy="45" rx="30" ry="8" fill="#8B4513" />

                <!-- Queijo -->
                <ellipse cx="50" cy="55" rx="28" ry="6" fill="#FFD700" />

                <!-- Tomate -->
                <ellipse cx="50" cy="62" rx="26" ry="5" fill="#FF6347" />

                <!-- Pão Inferior -->
                <ellipse cx="50" cy="70" rx="35" ry="10" fill="#D2691E" stroke="#8B4513" stroke-width="1" />
            </svg>
            <h3 class="category-title">Hambúrgueres</h3>
        </a>

        <!-- Pizza -->
        <a href="/categoria/2" class="category-card">
            <svg class="category-icon" viewBox="0 0 100 100" fill="none">
                <!-- Base da Pizza -->
                <circle cx="50" cy="50" r="35" fill="#DEB887" stroke="#CD853F" stroke-width="2" />
                <!-- Molho -->
                <circle cx="50" cy="50" r="30" fill="#DC143C" />
                <!-- Queijo -->
                <circle cx="50" cy="50" r="28" fill="#FFFF99" opacity="0.8" />
                <!-- Pepperoni -->
                <circle cx="40" cy="40" r="4" fill="#8B0000" />
                <circle cx="60" cy="45" r="4" fill="#8B0000" />
                <circle cx="45" cy="60" r="4" fill="#8B0000" />
                <circle cx="55" cy="35" r="4" fill="#8B0000" />
                <!-- Azeitonas -->
                <circle cx="35" cy="55" r="3" fill="#2F4F2F" />
                <circle cx="65" cy="60" r="3" fill="#2F4F2F" />
                <!-- Fatia cortada -->
                <path d="M 50 50 L 50 15 L 65 25 Z" fill="#DEB887" stroke="#CD853F" stroke-width="2" />
            </svg>
            <h3 class="category-title">Pizza</h3>
        </a>

        <!-- Bebidas -->
        <a href="/categoria/3" class="category-card">
            <svg class="category-icon" viewBox="0 0 100 100" fill="none">
                <!-- Copo -->
                <path d="M 30 20 L 32 80 L 68 80 L 70 20 Z" fill="none" stroke="#333" stroke-width="2" />
                <!-- Líquido -->
                <path d="M 32 30 L 33 75 L 67 75 L 68 30 Z" fill="#4169E1" opacity="0.7" />
                <!-- Gelo -->
                <rect x="40" y="35" width="8" height="8" fill="white" opacity="0.8" rx="2" />
                <rect x="52" y="42" width="6" height="6" fill="white" opacity="0.8" rx="1" />
                <rect x="45" y="55" width="7" height="7" fill="white" opacity="0.8" rx="1" />
                <!-- Canudo -->
                <line x1="45" y1="20" x2="42" y2="5" stroke="#FF1493" stroke-width="3" stroke-linecap="round" />
                <!-- Tampa/Borda -->
                <ellipse cx="50" cy="20" rx="20" ry="3" fill="none" stroke="#333" stroke-width="2" />
                <!-- Bolhas -->
                <circle cx="45" cy="40" r="2" fill="white" opacity="0.6" />
                <circle cx="55" cy="50" r="1.5" fill="white" opacity="0.6" />
                <circle cx="50" cy="65" r="1" fill="white" opacity="0.6" />
            </svg>
            <h3 class="category-title">Bebidas</h3>
        </a>

        <!-- Sobremesas -->
        <a href="/categoria/4" class="category-card">
            <svg class="category-icon" viewBox="0 0 100 100" fill="none">
                <!-- Taça -->
                <path d="M 25 40 Q 25 60 50 65 Q 75 60 75 40 L 70 40 Q 70 55 50 58 Q 30 55 30 40 Z" fill="none" stroke="#333" stroke-width="2" />
                <!-- Base da taça -->
                <line x1="50" y1="65" x2="50" y2="80" stroke="#333" stroke-width="2" />
                <ellipse cx="50" cy="80" rx="15" ry="3" fill="none" stroke="#333" stroke-width="2" />

                <!-- Sorvete -->
                <ellipse cx="50" cy="45" rx="18" ry="12" fill="#FFB6C1" />
                <ellipse cx="50" cy="35" rx="15" ry="10" fill="#FFF8DC" />
                <ellipse cx="50" cy="28" rx="12" ry="8" fill="#FF69B4" />

                <!-- Cereja no topo -->
                <circle cx="50" cy="22" r="3" fill="#DC143C" />
                <path d="M 50 22 Q 52 18 55 15" stroke="#228B22" stroke-width="2" fill="none" />

                <!-- Colheres -->
                <ellipse cx="60" cy="35" rx="2" ry="8" fill="#C0C0C0" transform="rotate(20 60 35)" />
                <ellipse cx="40" cy="35" rx="2" ry="8" fill="#C0C0C0" transform="rotate(-20 40 35)" />
            </svg>
            <h3 class="category-title">Sobremesas</h3>
        </a>
    </div>
</div>

<script>
    // Adicionar efeito de clique nos cards
    document.querySelectorAll('.category-card').forEach(card => {
        card.addEventListener('click', function(e) {
            // Adiciona um pequeno efeito visual ao clicar
            this.style.transform = 'scale(0.98)';
            setTimeout(() => {
                this.style.transform = '';
            }, 150);
        });
    });

    // Funcionalidade do menu hambúrguer (placeholder)
    document.querySelector('.menu-icon').addEventListener('click', function() {
        alert('Menu clicked - implementar navegação');
    });

    // Funcionalidade do carrinho (placeholder)
    document.querySelector('.cart-icon').addEventListener('click', function() {
        alert('Cart clicked - implementar carrinho');
    });
</script>
