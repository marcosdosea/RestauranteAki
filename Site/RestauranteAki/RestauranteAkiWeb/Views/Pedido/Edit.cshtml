@model RestauranteAkiWeb.Models.PedidoViewModel

@{
    ViewData["SubTitle"] = "Editar Pedido";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-styles.css" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card" data-aos="fade-up">
                <div class="card-header-custom">
                    <div class="logo-box">
                        <i class="fas fa-pencil-alt"></i>
                    </div>
                    <span class="header-title">@ViewData["SubTitle"] #@Model.Id</span>
                </div>
                <div class="card-body card-body-custom">

                    <h4>Editando o Pedido</h4>
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <form asp-action="Edit" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <input type="hidden" asp-for="Id" />

                                <div class="form-group mb-3">
                                    <label asp-for="Status" class="control-label mb-2"></label>
                                    <select asp-for="Status" class="form-select form-select-lg">
                                        <option value="">Selecione um status</option>
                                        <option value="S">Solicitado</option>
                                        <option value="P">Pronto</option>
                                        <option value="E">Entregue</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="IdConta" class="control-label mb-2"></label>
                                    <input asp-for="IdConta" class="form-control" />
                                    <span asp-validation-for="IdConta" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="IdMesa" class="control-label mb-2"></label>
                                    <input asp-for="IdMesa" class="form-control" />
                                    <span asp-validation-for="IdMesa" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="IdPersonagem" class="control-label mb-2"></label>
                                    <input asp-for="IdPersonagem" class="form-control" />
                                    <span asp-validation-for="IdPersonagem" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="IdPessoa" class="control-label mb-2"></label>
                                    <input asp-for="IdPessoa" class="form-control" />
                                    <span asp-validation-for="IdPessoa" class="text-danger"></span>
                                </div>

                                <div class="form-group mt-4 d-flex gap-2">
                                    <button type="submit" class="btn btn-green btn-animated">
                                        <i class="fas fa-save me-2"></i>Salvar
                                    </button>
                                    <a asp-action="Index" class="btn btn-secondary btn-animated">Cancelar</a>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        
        document.body.classList.add('bg-animated');
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}