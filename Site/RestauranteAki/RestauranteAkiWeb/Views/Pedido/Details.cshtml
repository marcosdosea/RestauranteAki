@model RestauranteAkiWeb.Models.PedidoViewModel

@{
    ViewData["Title"] = "Detalhes do Pedido";

}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-styles.css" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="glass-card" data-aos="fade-up">
                <div class="card-header-custom">
                    <div class="logo-box">
                        <i class="fas fa-receipt"></i>
                    </div>
                    <span class="header-title">@ViewData["Title"] #@Model.Id</span>
                </div>
                <div class="card-body card-body-custom">

                    <div class="d-flex justify-content-end gap-2 mb-4">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-orange btn-animated">
                            <i class="fas fa-pencil-alt me-2"></i>Editar
                        </a>
                        <a asp-action="Index" class="btn btn-secondary btn-animated">Voltar para a Lista</a>
                    </div>

                    <hr />

                    <div class="row mt-4 align-items-center">
                        <div class="col-md-4 text-center mb-4 mb-md-0">
                            <img class="details-img" src="/avatar-default.jpg" alt="Imagem do pedido" />
                        </div>

                        <div class="col-md-8">
                            <h4 class="mb-4">Informações do Pedido</h4>
                            <dl class="row details-list">
                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">@Model.Status</dd>

                                <dt class="col-sm-4">ID da Conta</dt>
                                <dd class="col-sm-8">@Model.IdConta</dd>

                                <dt class="col-sm-4">ID da Mesa</dt>
                                <dd class="col-sm-8">@Model.IdMesa</dd>

                                <dt class="col-sm-4">ID do Personagem</dt>
                                <dd class="col-sm-8">@Model.IdPersonagem</dd>

                                <dt class="col-sm-4">ID da Pessoa</dt>
                                <dd class="col-sm-8">@Model.IdPessoa</dd>
                            </dl>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.body.classList.add('bg-animated');
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}