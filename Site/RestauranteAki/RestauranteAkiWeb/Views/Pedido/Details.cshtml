@model RestauranteAkiWeb.Models.PedidoViewModel

@{
    ViewData["Title"] = "Detalhes do Pedido";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a></div>
            <div><a asp-action="Index" class="btn btn-secondary">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Pedido</div>
        <div class="card-list">
            <div class="itemPedido-card">
                <img class="itemPedido-img" src="/avatar-default.jpg" alt="Imagem do pedido" /> @* Imagem momentânea *@
                <div class="itemPedido-info">
                    <div class="itemPedido-detail">
                        <strong>Id:</strong> @Model.Id
                    </div>
                    <div class="itemPedido-detail">
                        <strong>Status:</strong> @Model.Status
                    </div>
                    <div class="itemPedido-detail">
                        <strong>Conta:</strong> @Model.IdConta
                    </div>
                    <div class="itemPedido-detail">
                        <strong>Mesa:</strong> @Model.IdMesa
                    </div>
                    <div class="itemPedido-detail">
                        <strong>Personagem:</strong> @Model.IdPersonagem
                    </div>
                    <div class="itemPedido-detail">
                        <strong>Pessoa:</strong> @Model.IdPessoa
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .itemPedido-img {
        width: 240px;
        height: 240px;
        object-fit: cover;
        border-radius: 0.5rem;
    }

    .itemPedido-info{
        flex-direction: column;
        align-items: flex-start;
        margin-left: 2rem;
    }

    .itemPedido-detail {
        font-size: 1.5rem;
    }
</style>