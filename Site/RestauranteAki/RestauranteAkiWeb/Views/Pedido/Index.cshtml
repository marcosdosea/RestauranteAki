@model IEnumerable<RestauranteAkiWeb.Models.PedidoViewModel>

@{
    ViewData["Title"] = "Pedidos";
}

<h2>Pedidos</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo Pedido</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>@Html.DisplayNameFor(model => model.IdConta)</th>
            <th>@Html.DisplayNameFor(model => model.IdMesa)</th>
            <th>@Html.DisplayNameFor(model => model.IdPersonagem)</th>
            <th>@Html.DisplayNameFor(model => model.IdPessoa)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Status</td>
                <td>@item.IdConta</td>
                <td>@item.IdMesa</td>
                <td>@item.IdPersonagem</td>
                <td>@item.IdPessoa</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalhes</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>