@model IEnumerable<RestauranteAkiWeb.Models.PedidoViewModel>

@{
    ViewData["Title"] = "Pedidos";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <div><a asp-action="Create" class="btn btn-primary">Adicionar Novo</a></div>
            <div><a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Lista de Pedidos</div>
        <div class="card-list">
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="itemPedido-card">
                        @* <img class="itemPedido-img"
                             src="@(item.Imagem != null && item.Imagem.Length > 0
                                                             ? $"data:image/jpeg;base64,{Convert.ToBase64String(item.Imagem)}"
                                                             : "/avatar-default.jpg")"
                             alt="Foto de @item." /> *@
                        <img class="itemPedido-img" src="/avatar-default.jpg" /> @* Imagem momentanea *@
                        <div class="itemPedido-info">
                            @* <span class="itemPedido-name">@item.NomeItem</span> *@
                            <span class="itemPedido-name">@item.Id</span> @* Nome momentaneo *@
                            <div class="itemPedido-status">@item.Status</div>
                        </div>
                        <div class="itemPedido-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">Exibir</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-data">Nenhum garçom cadastrado.</div>
            }
        </div>
    </section>
</div>