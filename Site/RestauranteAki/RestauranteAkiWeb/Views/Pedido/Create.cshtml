@model RestauranteAkiWeb.Models.NovoPedidoViewModel

@{
    ViewData["Title"] = "Novo Pedido";
    var mesas = ViewBag.Mesas as List<RestauranteAkiWeb.Models.MesaViewModel>;
    var itensCardapio = ViewBag.ItensCardapio as List<RestauranteAkiWeb.Models.ItemcardapioViewModel>;
}

<style>
    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
    }

    .main-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    }

    .item-card {
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 15px;
        transition: all 0.3s ease;
        cursor: pointer;
        height: 100%;
    }

        .item-card:hover {
            border-color: #667eea;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.15);
        }

        .item-card.selected {
            border-color: #667eea;
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
        }

            .item-card.selected .card-text {
                color: rgba(255, 255, 255, 0.9);
            }

    .quantity-controls {
        display: none;
        align-items: center;
        gap: 10px;
        margin-top: 15px;
    }

    .item-card.selected .quantity-controls {
        display: flex;
    }

    .quantity-btn {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        border: 2px solid white;
        background: transparent;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        transition: all 0.2s ease;
    }

        .quantity-btn:hover {
            background: white;
            color: #667eea;
        }

    .quantity-display {
        background: white;
        color: #667eea;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: bold;
        min-width: 60px;
        text-align: center;
    }

    .mesa-select {
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 15px;
        padding: 15px;
        font-size: 16px;
        transition: border-color 0.3s ease;
    }

        .mesa-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

    .btn-primary-custom {
        background: linear-gradient(45deg, #667eea, #764ba2);
        border: none;
        padding: 12px 30px;
        border-radius: 25px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        }

    .item-image {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 15px;
    }

    .price-badge {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
        padding: 5px 15px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .section-title {
        color: white;
        font-weight: 700;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        margin-bottom: 30px;
        text-align: center;
    }
</style>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card main-card">
                <div class="card-header bg-transparent border-0 p-4">
                    <h2 class="text-center mb-0" style="color: #667eea; font-weight: 700;">
                        <i class="fas fa-utensils me-3"></i>Novo Pedido
                    </h2>
                </div>

                <div class="card-body p-4">
                    @using (Html.BeginForm("Create", "Pedido", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                    {
                     //   @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="IdPersonagem"/>
                        <!-- Seleção da Mesa -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h4 style="color: #667eea; margin-bottom: 20px;">
                                    <i class="fas fa-chair me-2"></i>Selecione a Mesa
                                </h4>
                                <div class="form-group">
                                    <select asp-for="IdMesa" asp-items="ViewBag.Mesas" class="form-select">
                                        <option value="">-- Selecione uma Mesa --</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <hr style="border-color: #667eea; margin: 40px 0;">

                        <!-- Itens do Cardápio -->
                        <div class="row">
                            <div class="col-12">
                                <h4 style="color: #667eea; margin-bottom: 30px;">
                                    <i class="fas fa-list me-2"></i>Selecione os Itens
                                </h4>

                                <div class="row g-4" id="itens-cardapio">
                                    @if (itensCardapio != null && itensCardapio.Any())
                                    {
                                        @for (int i = 0; i < itensCardapio.Count; i++)
                                        {
                                            var item = itensCardapio[i];
                                            <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                                                <div class="card item-card" data-item-id="@item.Id" onclick="toggleItem(@item.Id)">
                                                    <div class="card-body p-3">
                                                        @if (item.Imagem != null && item.Imagem.Length > 0)
                                                        {
                                                            var base64String = Convert.ToBase64String(item.Imagem);
                                                            <img src="data:image/jpeg;base64,@base64String" alt="@item.Nome" class="item-image" />
                                                        }
                                                        else
                                                        {
                                                            <div class="item-image bg-light d-flex align-items-center justify-content-center">
                                                                <i class="fas fa-utensils fa-3x text-muted"></i>
                                                            </div>
                                                        }

                                                        <h6 class="card-title fw-bold mb-2">@item.Nome</h6>

                                                        @if (!string.IsNullOrEmpty(item.Descricao))
                                                        {
                                                            <p class="card-text small mb-2">@item.Descricao</p>
                                                        }

                                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                                            <span class="price-badge">R$ @item.PrecoUnitario.ToString("F2")</span>
                                                            <small class="text-muted">@item.Porcao porções</small>
                                                        </div>

                                                        <div class="quantity-controls">
                                                            <button type="button" class="quantity-btn" onclick="decreaseQuantity(@item.Id, event)">
                                                                <i class="fas fa-minus"></i>
                                                            </button>
                                                            <span class="quantity-display" id="quantity-@item.Id">1</span>
                                                            <button type="button" class="quantity-btn" onclick="increaseQuantity(@item.Id, event)">
                                                                <i class="fas fa-plus"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Campos hidden para o form -->
                                                <input type="hidden" name="ItensCardapios[@i].ItemCardapioId" value="@item.Id" class="item-id-input" />
                                                <input type="hidden" name="ItensCardapios[@i].Quantidade" value="0" class="quantity-input" id="input-@item.Id" />
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="col-12">
                                            <div class="alert alert-info text-center">
                                                <i class="fas fa-info-circle me-2"></i>
                                                Nenhum item disponível no cardápio no momento.
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <hr style="border-color: #667eea; margin: 40px 0;">

                        <!-- Resumo e Botões -->
                        <div class="row">
                            <div class="col-12">
                                <div id="resumo-pedido" class="mb-4" style="display: none;">
                                    <h5 style="color: #667eea;">
                                        <i class="fas fa-receipt me-2"></i>Resumo do Pedido
                                    </h5>
                                    <div class="bg-light p-3 rounded" id="itens-selecionados">
                                        <!-- Será preenchido via JavaScript -->
                                    </div>
                                </div>

                                <div class="text-center">
                                    <button type="submit" class="btn btn-primary-custom btn-lg me-3" id="btn-confirmar" disabled>
                                        <i class="fas fa-check me-2"></i>Confirmar Pedido
                                    </button>
                                    <a href="@Url.Action("Index", "Pedido")" class="btn btn-outline-secondary btn-lg">
                                        <i class="fas fa-times me-2"></i>Cancelar
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let selectedItems = {};
    let itemIndex = 0;

    function toggleItem(itemId) {
        const card = document.querySelector(`[data-item-id="${itemId}"]`);
        const input = document.getElementById(`input-${itemId}`);

        if (selectedItems[itemId]) {
            // Desselecionar item
            delete selectedItems[itemId];
            card.classList.remove('selected');
            input.disabled = true;
            input.value = 0;
            document.getElementById(`quantity-${itemId}`).textContent = '1';
        } else {
            // Selecionar item
            selectedItems[itemId] = 1;
            card.classList.add('selected');
            input.disabled = false;
            input.value = 1;
        }

        updateForm();
        updateResumo();
    }

    function increaseQuantity(itemId, event) {
        event.stopPropagation();
        if (selectedItems[itemId]) {
            selectedItems[itemId]++;
            document.getElementById(`quantity-${itemId}`).textContent = selectedItems[itemId];
            document.getElementById(`input-${itemId}`).value = selectedItems[itemId];
            updateResumo();
        }
    }

    function decreaseQuantity(itemId, event) {
        event.stopPropagation();
        if (selectedItems[itemId] && selectedItems[itemId] > 1) {
            selectedItems[itemId]--;
            document.getElementById(`quantity-${itemId}`).textContent = selectedItems[itemId];
            document.getElementById(`input-${itemId}`).value = selectedItems[itemId];
            updateResumo();
        }
    }

    function updateForm() {
        // Atualizar índices dos campos do form
        const container = document.getElementById('itens-cardapio');
        const items = container.querySelectorAll('.col-12');

        let index = 0;
        items.forEach((item, i) => {
            const itemIdInput = item.querySelector('.item-id-input');
            const quantityInput = item.querySelector('.quantity-input');

            if (!quantityInput.disabled) {
                itemIdInput.name = `ItensCardapios[${index}].ItemCardapioId`;
                quantityInput.name = `ItensCardapios[${index}].Quantidade`;
                index++;
            }
        });

        // Habilitar/desabilitar botão de confirmação
        const btnConfirmar = document.getElementById('btn-confirmar');
        const mesaSelect = document.querySelector('select[name="IdMesa"]');
        const hasItems = Object.keys(selectedItems).length > 0;
        const hasMesa = mesaSelect.value !== '';

        btnConfirmar.disabled = !(hasItems && hasMesa);
    }

    function updateResumo() {
        const resumoDiv = document.getElementById('resumo-pedido');
        const itensDiv = document.getElementById('itens-selecionados');

        if (Object.keys(selectedItems).length === 0) {
            resumoDiv.style.display = 'none';
            return;
        }

        resumoDiv.style.display = 'block';
        let html = '';
        let total = 0;

        for (const itemId in selectedItems) {
            const quantity = selectedItems[itemId];
            const card = document.querySelector(`[data-item-id="${itemId}"]`);
            const name = card.querySelector('.card-title').textContent;
            const priceText = card.querySelector('.price-badge').textContent;
            const price = parseFloat(priceText.replace('R$ ', '').replace(',', '.'));
            const subtotal = price * quantity;
            total += subtotal;

            html += `
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <strong>${name}</strong><br>
                        <small class="text-muted">R$ ${price.toFixed(2)} x ${quantity}</small>
                    </div>
                    <div class="text-end">
                        <strong>R$ ${subtotal.toFixed(2)}</strong>
                    </div>
                </div>
            `;
        }

        html += `
            <div class="d-flex justify-content-between align-items-center py-3 mt-2">
                <h6 class="mb-0">Total:</h6>
                <h5 class="mb-0 text-primary">R$ ${total.toFixed(2)}</h5>
            </div>
        `;

        itensDiv.innerHTML = html;
    }

    // Event listener para mudança na seleção da mesa
    document.querySelector('select[name="IdMesa"]').addEventListener('change', function() {
        updateForm();
    });
</script>