@model RestauranteAkiWeb.Models.NovoPedidoViewModel

@{
    ViewData["SubTitle"] = "Novo Pedido";

}

@section Styles {
    <link rel="stylesheet" href="~/css/create-pedido.css" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-15">
            <div class="glass-card" data-aos="fade-up">
                <div class="card-header-custom">
                    <div class="logo-box">
                        <i class="fas fa-plus"></i>
                    </div>
                    <span class="header-title">@ViewData["SubTitle"]</span>
                </div>
                <div class="card-body card-body-custom">

                    <h4>Criar novo pedido</h4>
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <form asp-action="Create">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <div class="form-group mb-3">
                                    <label asp-for="IdMesa" class="control-label mb-2">Mesa</label>
                                    <select asp-for="IdMesa" class="form-select form-select-lg" asp-items="ViewBag.Mesas">
                                        <option value="">-- Selecione uma Mesa --</option>
                                    </select>
                                    <span asp-validation-for="IdMesa" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label class="control-label mb-2">Itens do Cardápio</label>
                                    <div class="alert alert-info small">
                                        <em>Para selecionar múltiplos itens, por favor, use a funcionalidade avançada de criação de pedidos.</em>
                                    </div>
                                </div>

                                <input type="hidden" asp-for="IdPersonagem" />

                                <div class="form-group mt-4 d-flex gap-2">
                                    <button type="submit" class="btn btn-green btn-animated">
                                        <i class="fas fa-check me-2"></i>Criar
                                    </button>
                                    <a asp-action="Index" class="btn btn-secondary btn-animated">Voltar para a Lista</a>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.body.classList.add('bg-animated');
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}