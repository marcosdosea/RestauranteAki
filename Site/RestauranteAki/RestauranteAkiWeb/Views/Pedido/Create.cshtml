@model RestauranteAkiWeb.Models.PedidoCreateViewModel
@{
    Layout = null; // Sem layout para garantir tela cheia total
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Novo Pedido</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-orange: #F27022;
        }

        body {
            background-color: #f8f9fa;
            overflow: hidden;
            font-family: 'Segoe UI', sans-serif;
        }

        /* MODAL FULL SCREEN (Base para as telas) */
        .fs-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: white;
            z-index: 100;
            overflow-y: auto;
            display: none; /* Escondido por padrão */
            flex-direction: column;
        }

            .fs-modal.active {
                display: flex;
            }

        /* HEADER */
        .modal-header-custom {
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: white;
            border-bottom: 1px solid #eee;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .header-title {
            font-weight: 800;
            font-size: 1.2rem;
            margin: 0;
        }

        /* GRID PERSONAGENS (TELA 1) */
        .personagem-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            padding: 20px;
        }

        .personagem-card {
            border: 1px solid #ddd;
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            cursor: pointer;
            transition: 0.2s;
        }

            .personagem-card:active {
                background-color: #fff5f0;
                border-color: var(--primary-orange);
            }

        .icon-trash {
            position: absolute;
            top: 10px;
            right: 10px;
            color: #999;
        }

        .p-icon {
            font-size: 3rem;
            margin-bottom: 10px;
            color: #333;
        }

        .btn-add-client {
            background-color: var(--primary-orange);
            color: white;
            border: none;
            padding: 15px;
            border-radius: 8px;
            font-weight: bold;
            width: 90%;
            margin: 20px auto;
            display: block;
        }

        /* CARDÁPIO (TELA 2) */
        .categories-scroll {
            display: flex;
            overflow-x: auto;
            padding: 10px 15px;
            gap: 10px;
            background: white;
            white-space: nowrap;
            -webkit-overflow-scrolling: touch;
        }

        .cat-pill {
            padding: 8px 16px;
            border-radius: 20px;
            background: #f0f0f0;
            color: #666;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
        }

            .cat-pill.active {
                background: #333;
                color: white;
            }

        .search-container {
            padding: 10px 15px;
            background: white;
        }

        .search-box {
            background: #f5f5f5;
            border: 1px solid #ddd;
            border-radius: 25px;
            padding: 10px 20px;
            width: 100%;
            outline: none;
        }

        .menu-list {
            flex: 1;
            overflow-y: auto;
            padding-bottom: 80px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #eee;
            background: white;
        }

        .item-avatar {
            width: 50px;
            height: 50px;
            background: #e0e0ff;
            color: #666;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-size: 1.2rem;
        }

        .item-info {
            flex: 1;
        }

        .item-name {
            font-weight: 600;
            font-size: 1rem;
        }

        .item-price {
            color: #666;
            font-size: 0.9rem;
        }

        /* CONTROLE DE QUANTIDADE */
        .qty-control {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-plus-add {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid var(--primary-orange);
            color: var(--primary-orange);
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
        }

        .btn-minus {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid #ccc;
            color: #ccc;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
        }

        .qty-val {
            font-weight: bold;
            font-size: 1.1rem;
            min-width: 20px;
            text-align: center;
        }

        /* FOOTER DE AÇÃO */
        .action-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            display: flex;
            z-index: 200;
            box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
        }

        .btn-view-order {
            flex: 1;
            background: #5E5CE6;
            color: white;
            border: none;
            padding: 15px;
            font-weight: bold;
        }

        .btn-send-order {
            flex: 1;
            background: var(--primary-orange);
            color: white;
            border: none;
            padding: 15px;
            font-weight: bold;
        }

        .btn-disabled {
            opacity: 0.6;
            pointer-events: none;
        }

        /* BOTTOM SHEET (MODAL DE BAIXO PRA CIMA) */
        .bottom-sheet-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 300;
            display: none;
        }

        .bottom-sheet {
            position: fixed;
            bottom: -100%;
            left: 0;
            width: 100%;
            background: white;
            border-radius: 20px 20px 0 0;
            z-index: 301;
            transition: bottom 0.3s ease-out;
            max-height: 80%;
            display: flex;
            flex-direction: column;
        }

        .sheet-active {
            bottom: 0;
        }

        .sheet-header {
            padding: 20px;
            border-bottom: 1px solid #eee;
            font-weight: 800;
            font-size: 1.2rem;
        }

        .sheet-body {
            padding: 20px;
            overflow-y: auto;
        }

        .sheet-footer {
            padding: 20px;
            border-top: 1px solid #eee;
        }

    </style>
</head>
<body>

    <div id="modal-select-client" class="fs-modal active">
        <div class="modal-header-custom">
            <button class="btn btn-link text-dark" onclick="voltarParaHub()"><i class="fa-solid fa-xmark fa-xl"></i></button>
            <span class="header-title">Selecionar Cliente</span>
            <div style="width: 24px;"></div>
        </div>

        <div class="text-center mt-3 mb-2">
            <h5 class="fw-bold">Para quem é o pedido?</h5>
        </div>

        <div class="personagem-grid" id="gridPersonagens">
            @foreach (var p in Model.Personagens)
            {
                <div class="personagem-card" id="personagem-@p.Id" onclick="selecionarPersonagem(@p.Id, '@p.Nome')">
                    <i class="fa-regular fa-trash-can icon-trash" onclick="event.stopPropagation(); removerPersonagem(@p.Id)"></i>
                    <i class="fa-regular fa-user p-icon" style="color: @p.IdentificadorCor"></i>
                    <div class="fw-bold text-center">@p.Nome</div>
                </div>
            }
        </div>

        <div style="flex:1"></div> <button class="btn-add-client" onclick="adicionarNovoCliente()">
            <i class="fa-solid fa-circle-plus me-2"></i> Adicionar Cliente
        </button>
    </div>


    <div id="modal-select-items" class="fs-modal">
        <div class="modal-header-custom">
            <button class="btn btn-link text-dark" onclick="fecharCardapio()"><i class="fa-solid fa-xmark fa-xl"></i></button>
            <span class="header-title">Novo pedido</span>
            <div style="width: 24px;"></div>
        </div>

        <div class="categories-scroll">
            @foreach (var cat in Model.Categorias)
            {
                <div class="cat-pill">@cat.NomeCategoria</div>
            }
        </div>

        <div class="search-container">
            <input type="text" class="search-box" placeholder="Buscar item por nome...">
        </div>

        <div class="menu-list">
            @foreach (var cat in Model.Categorias)
            {
                <div class="px-3 py-2 bg-light fw-bold text-muted small">@cat.NomeCategoria.ToUpper()</div>
                @foreach (var item in cat.Itens)
                {
                    <div class="menu-item" data-id="@item.Id" data-name="@item.Nome" data-price="@item.Preco">
                        <div class="item-avatar"><i class="fa-solid fa-apple-whole"></i></div>
                        <div class="item-info">
                            <div class="item-name">@item.Nome</div>
                            <div class="item-price">@item.Preco.ToString("C")</div>
                        </div>

                        <div class="qty-control" id="ctrl-@item.Id">
                            <div class="btn-plus-add" onclick="addItem(@item.Id)">
                                <i class="fa-solid fa-plus"></i>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="action-footer" id="menu-footer" style="display:none">
            <button class="btn-view-order" onclick="abrirResumoParcial()">
                Ver Pedido (<span id="lbl-total-items">0</span> itens)
            </button>
            <button class="btn-send-order" onclick="abrirConfirmacaoEnvio()">
                Enviar Pedido (<span id="lbl-total-price">R$ 0,00</span>)
            </button>
        </div>
    </div>


    <div class="bottom-sheet-overlay" id="overlay-parcial" onclick="fecharResumoParcial()"></div>
    <div class="bottom-sheet" id="sheet-parcial">
        <div class="sheet-header">Resumo do Pedido</div>
        <div class="sheet-body" id="lista-resumo-parcial">
        </div>
        <div class="sheet-footer">
            <button class="btn btn-secondary w-100 py-3 rounded-3 fw-bold" onclick="fecharResumoParcial()">Continuar Pedindo</button>
        </div>
    </div>

    <div class="bottom-sheet-overlay" id="overlay-envio" onclick="fecharConfirmacaoEnvio()"></div>
    <div class="bottom-sheet" id="sheet-envio">
        <div class="sheet-header d-flex justify-content-between">
            <span>Confirmar Envio</span>
            <span id="lbl-total-confirmacao" class="text-primary">R$ 0,00</span>
        </div>
        <div class="sheet-body">
            <p class="text-muted mb-3">O pedido será enviado para produção.</p>
            <div id="lista-resumo-envio" class="mb-3">
            </div>
        </div>
        <div class="sheet-footer d-flex gap-2">
            <button class="btn btn-light flex-grow-1 py-3 fw-bold border" onclick="fecharConfirmacaoEnvio()">Cancelar</button>
            <button class="btn btn-primary flex-grow-1 py-3 fw-bold" style="background:var(--primary-orange); border:none" onclick="enviarPedidoFinal()">
                Confirmar
            </button>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // --- ESTADO DA APLICAÇÃO ---
        const idConta = @Model.IdConta;
        let selectedPersonagemId = null;
        let selectedPersonagemNome = "";
        let cart = {}; // Objeto: { idItem: { qtd, nome, preco } }

        // --- NAVEGAÇÃO ---
        function voltarParaHub() {
            window.location.href = '/Atendimento/Mesa/@Model.IdMesa';
        }

        function selecionarPersonagem(id, nome) {
            selectedPersonagemId = id;
            selectedPersonagemNome = nome;

            // Troca de tela
            document.getElementById('modal-select-client').classList.remove('active');
            document.getElementById('modal-select-items').classList.add('active');
        }

        function fecharCardapio() {
            // Volta para seleção de cliente
            document.getElementById('modal-select-items').classList.remove('active');
            document.getElementById('modal-select-client').classList.add('active');
            cart = {};
            renderCartUI();
        }

        // --- LÓGICA DE CARRINHO (+ / -) ---
        function addItem(id) {
            // Busca dados do DOM
            const el = document.querySelector(`.menu-item[data-id='${id}']`);
            const nome = el.getAttribute('data-name');
            const preco = parseFloat(el.getAttribute('data-price').replace(',', '.'));

            if (!cart[id]) {
                cart[id] = { qtd: 0, nome: nome, preco: preco };
            }
            cart[id].qtd++;
            updateItemControlUI(id);
            updateFooterUI();
        }

        function removeItem(id) {
            if (cart[id]) {
                cart[id].qtd--;
                if (cart[id].qtd <= 0) {
                    delete cart[id];
                }
            }
            updateItemControlUI(id);
            updateFooterUI();
        }

        function updateItemControlUI(id) {
            const container = document.getElementById(`ctrl-${id}`);
            const qtd = cart[id] ? cart[id].qtd : 0;

            if (qtd === 0) {
                container.innerHTML = `
                    <div class="btn-plus-add" onclick="addItem(${id})">
                        <i class="fa-solid fa-plus"></i>
                    </div>
                `;
            } else {
                container.innerHTML = `
                    <div class="btn-minus" onclick="removeItem(${id})"><i class="fa-solid fa-minus"></i></div>
                    <div class="qty-val">${qtd}</div>
                    <div class="btn-plus-add" onclick="addItem(${id})"><i class="fa-solid fa-plus"></i></div>
                `;
            }
        }

        function renderCartUI() {
             document.querySelectorAll('.menu-item').forEach(item => {
                 updateItemControlUI(item.getAttribute('data-id'));
             });
             updateFooterUI();
        }

        function updateFooterUI() {
            let totalQtd = 0;
            let totalPrice = 0;

            for (const id in cart) {
                totalQtd += cart[id].qtd;
                totalPrice += (cart[id].qtd * cart[id].preco);
            }

            const footer = document.getElementById('menu-footer');
            if (totalQtd > 0) {
                footer.style.display = 'flex';
                document.getElementById('lbl-total-items').innerText = totalQtd;
                document.getElementById('lbl-total-price').innerText = totalPrice.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                document.getElementById('lbl-total-confirmacao').innerText = totalPrice.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            } else {
                footer.style.display = 'none';
            }
        }

        // --- MODAIS INFERIORES (BOTTOM SHEETS) ---
        function abrirResumoParcial() {
            renderListaResumo('lista-resumo-parcial');
            document.getElementById('overlay-parcial').style.display = 'block';
            setTimeout(() => document.getElementById('sheet-parcial').classList.add('sheet-active'), 10);
        }

        function fecharResumoParcial() {
            document.getElementById('sheet-parcial').classList.remove('sheet-active');
            setTimeout(() => document.getElementById('overlay-parcial').style.display = 'none', 300);
        }

        function abrirConfirmacaoEnvio() {
            renderListaResumo('lista-resumo-envio');
            document.getElementById('overlay-envio').style.display = 'block';
            setTimeout(() => document.getElementById('sheet-envio').classList.add('sheet-active'), 10);
        }

        function fecharConfirmacaoEnvio() {
            document.getElementById('sheet-envio').classList.remove('sheet-active');
            setTimeout(() => document.getElementById('overlay-envio').style.display = 'none', 300);
        }

        function renderListaResumo(containerId) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';

            for (const id in cart) {
                const item = cart[id];
                const totalItem = item.qtd * item.preco;
                container.innerHTML += `
                    <div class="d-flex justify-content-between mb-2">
                        <div><span class="fw-bold">${item.qtd}x</span> ${item.nome}</div>
                        <div>${totalItem.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</div>
                    </div>
                `;
            }
        }

        // --- Chamadas de API 
        async function adicionarNovoCliente() {
            try {
                const response = await fetch(`/api/AtendimentoApi/contas/${idConta}/personagens`, {
                    method: 'POST'
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                // const novoPersonagem = await response.json();
                // renderizarNovoPersonagem(novoPersonagem);
            } catch (error) {
                console.error('Erro ao adicionar personagem:', error);
            }
            window.location.reload(); // Recarregar para atualizar a lista (por enquanto)
        }

        async function removerPersonagem(id) {
             if (!confirm('Deseja realmente remover este personagem?')) return;

             try {
                const response = await fetch(`/api/AtendimentoApi/personagens/${id}`, {
                    method: 'DELETE'
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                document.getElementById(`personagem-${id}`).remove();
            } catch (error) {
                console.error('Erro ao remover personagem:', error);
            }
        }

        // Enviar Pedido Final
        async function enviarPedidoFinal() {
            const payload = {
                idConta: idConta,
                idPersonagem: selectedPersonagemId,
                itens: []
            };

            for (const id in cart) {
                payload.itens.push({ idItem: parseInt(id), quantidade: cart[id].qtd });
            }

            try {
                const response = await fetch('/Pedido/SalvarPedido', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    alert("Pedido enviado com sucesso!");
                    voltarParaHub();
                } else {
                    alert("Erro ao enviar pedido.");
                }
            } catch (error) {
                console.error(error);
                alert("Erro de conexão.");
            }
        }

    </script>
</body>
</html>