@model IEnumerable<RestauranteAkiWeb.Models.CardapioViewModel>

@{
    ViewData["Title"] = "Cardápio";
}

<div>
    <div class="main-header">
        <h1 class="main-title"></h1>
        <div class="main-actions">
            <a asp-action="Create" class="btn btn-primary">Adicionar Novo</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Cardápio</div>
        <div class="card-list">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="person-card">
                        <div class="person-info">
                            <span class="person-name">@item.Nome</span>
                            <span class="person-details">Início: @item.DataInicio.ToString("dd/MM/yyyy")</span>
                            <span class="person-details">Fim: @item.DataFim.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="person-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">Detalhes</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Deletar</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="no-data">Nenhum Cardápio cadastrado.</p>
            }
        </div>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" />
}
