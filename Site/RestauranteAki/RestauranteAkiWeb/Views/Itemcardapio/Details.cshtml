@model RestauranteAkiWeb.Models.ItemcardapioViewModel

@{
    ViewData["Title"] = "Detalhes do Item do Cardápio";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
            <a class="btn btn-secondary" onclick="history.back();">Voltar</a>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Item do Cardápio</div>

        <div class="row gy-2 gx-4 p-3">
            <div class="col-md-8">
                <dl class="row">
                    <dt class="col-sm-4">Nome</dt>
                    <dd class="col-sm-8">@Model.Nome</dd>

                    <dt class="col-sm-4">Categoria</dt>
                    <dd class="col-sm-8">
                        @{
                            var categorias = new Dictionary<string, string>
                                                {
                                                { "1", "Hamburger" },
                                                { "2", "Pizza" },
                                                { "3", "Bebida" },
                                                { "4", "Sobremesa" }
                                                };
                            var categoriaNome = categorias.ContainsKey(Model.Categoria) ? categorias[Model.Categoria] : "Não definida";
                        }
                        <span class="badge bg-info text-dark">@categoriaNome</span>
                    </dd>

                    <dt class="col-sm-4">Preço</dt>
                    <dd class="col-sm-8">R$ @Model.PrecoUnitario.ToString("N2")</dd>

                    <dt class="col-sm-4">Porção</dt>
                    <dd class="col-sm-8">@Model.Porcao</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status)
                        {
                            <span class="badge bg-success">Disponível</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Indisponível</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Dias da Semana</dt>
                    <dd class="col-sm-8">
                        @if (Model.DiasSemana != null && Model.DiasSemana.Any())
                        {
                            @foreach (var dia in Model.DiasSemana)
                            {
                                <span class="badge bg-dark text-light me-1">@dia</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Não definido</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Ingredientes</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Descricao))
                        {
                            var ingredientes = Model.Descricao.Split(',', StringSplitOptions.RemoveEmptyEntries);
                            <ul class="list-group list-group-flush">
                                @foreach (var ing in ingredientes)
                                {
                                    <li class="list-group-item">@ing.Trim()</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">Nenhum ingrediente informado</span>
                        }
                    </dd>
                </dl>
            </div>

            <div class="col-md-4 text-centera">
                <span class="d-block fw-bold mb-2">Imagem</span>
                @if (!string.IsNullOrEmpty(Model.ImagemAtual))
                {
                    var imgSrc = $"data:image/jpeg;base64,{Model.ImagemAtual}";
                    <img src="@imgSrc" class="img-thumbnail" alt="Imagem do item" />
                }
                else
                {
                    <p class="text-muted">Nenhuma imagem cadastrada</p>
                }
            </div>
        </div>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/itemcardapio.css" />
}
