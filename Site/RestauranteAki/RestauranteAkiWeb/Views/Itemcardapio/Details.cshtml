@model RestauranteAkiWeb.Models.ItemcardapioViewModel

@{
    ViewData["Title"] = "Detalhes Item do Cardápio";
    var dias = new[] { "S", "T", "Q", "Q", "S", "S", "D" };
    var nomes = new[] { "Seg", "Ter", "Qua", "Qui", "Sex", "Sab", "Dom" };
    var diasSelecionados = (Model.DiaSemana ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
}

<div class="main-content">
    

    <section class="card-list-section">
        <div class="card-list-header">Item do Cardápio</div>
        <div class="form-cardapio">
            <div class="form-row">
                <div class="flex-two">
                    <div class="form-group">
                        <label class="form-label">Nome do Prato*</label>
                        <div class="form-control-plaintext">@Model.Nome</div>
                    </div>
                    <div class="form-group margin-top">
                        <label class="form-label">Categoria *</label>
                        <div class="form-control-plaintext">
                            @{
                                var categorias = new Dictionary<int, string> {
                                    {1, "Hamburger"}, {2, "Pizza"}, {3, "Bebida"}, {4, "Sobremesa"}
                                };
                                @categorias.GetValueOrDefault(Model.Categoria, "Desconhecida")
                            }
                        </div>
                    </div>
                    <div class="form-row margin-top">
                        <div class="form-group flex-one">
                            <label class="form-label">Preço</label>
                            <div class="form-control-plaintext">R$ @Model.PrecoUnitario.ToString("N2")</div>
                        </div>
                        <div class="form-group flex-one">
                            <label class="form-label">Disponível</label>
                            <div class="switch-container" style="pointer-events:none;">
                                <input type="checkbox" class="toggle-switch" @(Model.Status ? "checked" : "") disabled />
                            </div>
                        </div>
                    </div>
                    <div class="form-group margin-top">
                        <label class="form-label">Dia da semana</label>
                        <div class="dias-semana">
                            @for (int i = 0; i < dias.Length; i++)
                            {
                                <label class="dia-checkbox">
                                    <input type="checkbox" value="@nomes[i]" @(diasSelecionados.Contains(nomes[i]) ? "checked" : "") disabled />
                                    <span>@dias[i]</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="form-group margin-top">
                        <label class="form-label">Porção *</label>
                        <div class="form-control-plaintext">@Model.Porcao</div>
                    </div>
                    <div class="form-group margin-top">
                        <label class="form-label">Descrição</label>
                        <div class="form-control-plaintext">@Model.Descricao</div>
                    </div>
                    
                </div>
                <div class="flex-one-min">
                    <div class="form-group">
                        <label class="form-label">Foto *</label>
                        <div class="foto-upload">
                            @if (Model.Imagem != null && Model.Imagem.Length > 0)
                            {
                                var base64 = Convert.ToBase64String(Model.Imagem);
                                <img src="data:image/png;base64,@base64" style="max-width:150px;max-height:150px; margin-top:10px;" />
                            }
                            else
                            {
                                <span>Sem imagem</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-secondary btn-rounded">Voltar</a>
            </div>
        </div>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" />
    /<style>
        .main-content {
            margin-top: 32px;
        }
        .card-list-section {
            margin-top: 24px;
        }
        .form-label {
            font-weight: 600;
            color: #2d2d7f;
            padding-left: 24px;
        }
        .form-control-plaintext {
            padding: 8px 0 8px 24px;
            color: #222;
        }
        .form-group {
            margin-bottom: 16px;
        }
        .dias-semana { display: flex; gap: 8px; margin-top: 8px; padding-left: 24px; }
        .dia-checkbox input { display: none; }
        .dia-checkbox span {
            display: inline-block;
            width: 32px; height: 32px;
            border-radius: 8px;
            background: #ff6c00;
            color: #fff;
            text-align: center;
            line-height: 32px;
            font-weight: 700;
            cursor: default;
            transition: background 0.2s;
        }
        .dia-checkbox input:checked + span {
            background: #2d2d7f;
            color: #fff;
        }
        .foto-upload { margin-top: 8px; padding-left: 24px; }
        .foto-dropzone {
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px dashed #bdbdbd;
            border-radius: 12px;
            width: 160px;
            height: 160px;
            cursor: pointer;
            color: #888;
            text-align: center;
            font-size: 0.95rem;
            background: #fafaff;
            transition: border 0.2s;
        }
        .foto-dropzone:hover {
            border-color: #ff6c00;
        }
        .toggle-switch {
            width: 40px;
            height: 22px;
            appearance: none;
            background: #ff6c00;
            outline: none;
            border-radius: 20px;
            position: relative;
            transition: background 0.2s;
        }
        .toggle-switch:checked {
            background: #2d2d7f;
        }
        .toggle-switch::before {
            content: '';
            position: absolute;
            left: 4px;
            top: 4px;
            width: 14px;
            height: 14px;
            background: #fff;
            border-radius: 50%;
            transition: left 0.2s;
        }
        .toggle-switch:checked::before {
            left: 22px;
        }
        .main-content {
            margin-top: 32px; /* Espaço do topo */
        }
        .card-list-section {
            margin-top: 24px; /* Espaço extra entre header e card */
        }
    </style>
}