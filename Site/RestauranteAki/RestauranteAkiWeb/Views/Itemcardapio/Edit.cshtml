@model RestauranteAkiWeb.Models.ItemcardapioViewModel

@{
    ViewData["Title"] = "Editar Item do Cardápio";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <div><a class="btn btn-secondary" onclick="history.back();">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Editar Item do Cardápio</div>
        <div class="row">
            <div class="col-12">
                <div class="item-card-form">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImagemAtual" />

                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label asp-for="Nome" class="control-label"></label>
                                    <input asp-for="Nome" class="form-control" />
                                    <span asp-validation-for="Nome" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Categoria" class="control-label"></label>
                                    <select asp-for="Categoria" class="form-select">
                                        <option value="">Selecione</option>
                                        <option value="1">Hamburger</option>
                                        <option value="2">Pizza</option>
                                        <option value="3">Bebida</option>
                                        <option value="4">Sobremesa</option>
                                    </select>
                                    <span asp-validation-for="Categoria" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="form-group col-md-6">
                                        <label asp-for="PrecoUnitario" class="control-label">Preço</label>
                                        <input asp-for="PrecoUnitario" class="form-control" placeholder="R$ 0,00" type="number" step="0.01" min="0" />
                                        <span asp-validation-for="PrecoUnitario" class="text-danger"></span>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label asp-for="Porcao" class="control-label"></label>
                                        <input asp-for="Porcao" class="form-control" type="number" min="1" />
                                        <span asp-validation-for="Porcao" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="control-label d-block">Disponível</label>
                                    <label class="switch">
                                        <input asp-for="Status" type="checkbox" />
                                        <span class="slider"></span>
                                    </label>
                                </div>

                                <div class="form-group">
                                    <label class="control-label">Dias da semana</label>
                                    <div class="dias-semana">
                                        @{
                                            var dias = new[] { "S", "T", "Q", "Q", "S", "S", "D" };
                                            var nomes = new[] { "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado", "Domingo" };
                                            var diasSelecionados = Model.DiasSemana ?? new List<string>();

                                            for (int i = 0; i < dias.Length; i++)
                                            {
                                                <label class="dia-checkbox">
                                                    <input type="checkbox" name="DiasSemana" value="@nomes[i]" @(diasSelecionados.Contains(nomes[i]) ? "checked" : "") />
                                                    <span>@dias[i]</span>
                                                </label>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="form-group">
                                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ingredientesModal">
                                        Adicionar/Editar Ingredientes
                                    </button>
                                </div>

                                <div class="modal fade" id="ingredientesModal" tabindex="-1"
                                     data-api-url="@Url.Action("GetIngredientesUnicos", "Itemcardapio")"
                                     aria-labelledby="ingredientesModalLabel" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="ingredientesModalLabel">Selecionar Ingredientes</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <ul id="lista-modal" class="list-group mb-3"></ul>
                                                <div class="input-group">
                                                    <input type="text" id="novo-ingrediente-modal" class="form-control" placeholder="Adicionar novo ingrediente">
                                                    <button type="button" id="btn-adicionar-modal" class="btn btn-success">+</button>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="button" class="btn btn-primary" id="btn-salvar-modal">Salvar Ingredientes</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <input type="hidden" id="descricao" asp-for="Descricao" />
                                <span asp-validation-for="Descricao" class="text-danger"></span>

                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="ImagemUpload" class="control-label">Alterar Foto</label>
                                    <div class="foto-upload">
                                        @if (!string.IsNullOrEmpty(Model.ImagemAtual))
                                        {
                                            var imgSrc = $"data:image/jpeg;base64,{Model.ImagemAtual}";
                                            <img src="@imgSrc" class="img-thumbnail mb-2" alt="Imagem Atual" />
                                        }
                                        <input asp-for="ImagemUpload" type="file" accept="image/*" class="form-control-file" id="ImagemUpload" style="display: none;" />
                                        <label for="ImagemUpload" class="foto-dropzone">
                                            <span>Drag and drop<br />ou clique aqui<br />para selecionar nova foto</span>
                                        </label>
                                    </div>
                                    <span asp-validation-for="ImagemUpload" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-success">Salvar Alterações</button>
                            <a asp-action="Index" class="btn btn-danger">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/itemcardapio.css" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/itemcardapio.js"></script>
}