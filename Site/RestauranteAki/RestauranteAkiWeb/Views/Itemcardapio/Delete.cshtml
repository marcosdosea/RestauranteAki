@model RestauranteAkiWeb.Models.ItemcardapioViewModel

@{
    ViewData["Title"] = ViewBag.Title;
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Tem certeza que deseja excluir?');">
                <button type="submit" class="btn btn-danger">Excluir</button>
            </form>
            <a asp-action="@ViewBag.CancelAction" class="btn btn-secondary">Cancelar</a>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Item do cardápio</div>
        <div class="row">
            <div class="col-12">
                <div class="delete-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Atenção!</strong> Você tem certeza que deseja excluir permanentemente o registro abaixo?
                    Esta ação não pode ser desfeita.
                </div>

                <div class="item-card mb-4">
                    @{
                        var imgSrc = "/image-default.jpg";
                        if (Model.ImagemAtual != null && Model.ImagemAtual.Length > 0)
                        {
                            // var base64 = Convert.ToBase64String(Model.ImagemAtual);
                            // imgSrc = $"data:image/jpeg;base64,{base64}";
                        }
                    }
                    <div class="item-image me-md-4 mb-3 mb-md-0">
                        <img src="@imgSrc" alt="Foto de @Model.Nome" style="width: 150px; height: 150px; object-fit: cover; border-radius: 8px;" />
                    </div>

                    <div class="item-info">
                        <div class="item-detail">
                            <strong>Nome:</strong> @Model.Nome
                        </div>
                        <div class="item-detail">
                            <strong>Descrição:</strong> @Model.Descricao
                        </div>
                        <div class="item-detail">
                            <strong>Preço:</strong> @Model.PrecoUnitario.ToString("C")
                        </div>
                        <div class="item-detail">
                            <strong>Porção:</strong> @Model.Porcao
                        </div>
                        <div class="item-detail">
                            <strong>Categoria:</strong> @Model.Categoria
                        </div>
                        <div class="item-detail">
                            <strong>Status:</strong> @(Model.Status ? "Ativo" : "Inativo")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    @@media (min-width: 768px) {
        .item-info {
            flex-direction: column;
            align-items: flex-start;
            /* margin-left: 2rem; */
        }
    }
</style>