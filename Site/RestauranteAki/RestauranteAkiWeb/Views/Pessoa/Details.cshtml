@model RestauranteAkiWeb.Models.PessoaViewModel
@{
    ViewData["SubTitle"] = "Detalhes da Pessoa";

    var indexAction = Model.TipoPessoa == "G" ? "IndexGestor" : "IndexGarcom";
}
@section Styles {
    <link rel="stylesheet" href="~/css/restaurante-styles.css" />
}
<div class="container-fluid my-5">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="glass-card" data-aos="fade-up">
                <div class="card-header-custom">
                    <div class="logo-box">
                        <i class="fas fa-user"></i>
                    </div>
                    <span class="header-title">@ViewData["SubTitle"]</span>
                </div>
                <div class="card-body card-body-custom">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0">@Model.NomeCompleto</h4>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-orange btn-animated">
                                <i class="fas fa-pencil-alt me-2"></i>Editar
                            </a>
                            <a asp-action="@indexAction" class="btn btn-secondary btn-animated">
                                <i class="fas fa-arrow-left me-2"></i>Voltar para a Lista
                            </a>
                        </div>
                    </div>
                    <hr />
                    <dl class="row details-list mt-4">
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Id)</dt>
                        <dd class="col-sm-9">@Model.Id</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.NomeCompleto)</dt>
                        <dd class="col-sm-9">@Model.NomeCompleto</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Cpf)</dt>
                        <dd class="col-sm-9">@Model.Cpf</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
                        <dd class="col-sm-9">@Model.Email</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Telefone)</dt>
                        <dd class="col-sm-9">@Model.Telefone</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DataNascimento)</dt>
                        <dd class="col-sm-9">@Model.DataNascimento</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Cep)</dt>
                        <dd class="col-sm-9">@Model.Cep</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Logradouro)</dt>
                        <dd class="col-sm-9">@Model.Logradouro</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Bairro)</dt>
                        <dd class="col-sm-9">@Model.Bairro</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Cidade)</dt>
                        <dd class="col-sm-9">@Model.Cidade</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Estado)</dt>
                        <dd class="col-sm-9">@Model.Estado</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Complemento)</dt>
                        <dd class="col-sm-9">@Model.Complemento</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Foto)</dt>
                        <dd class="col-sm-9">@Model.Foto</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.IdRestaurante)</dt>
                        <dd class="col-sm-9">@Model.IdRestaurante</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.TipoPessoa)</dt>
                        <dd class="col-sm-9">@Model.TipoPessoa</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.body.classList.add('bg-animated');
    </script>
}