@model RestauranteAkiWeb.Models.PessoaViewModel

@{
    ViewData["Title"] = ViewBag.Title;
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a></div>
            <div><a class="btn btn-secondary" onclick="history.back();">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">@ViewBag.HeaderText</div>
        <div class="row">
            <div class="col-12">
                <div class="item-card">
                    @if (Model.Foto != null)
                    {
                        <div class="item-image">
                            @{
                                // var base64 = Convert.ToBase64String(Model.Foto);
                                // var imgSrc = $"data:image/jpeg;base64,{base64}";
                                var imgSrc = "/avatar-default.jpg";
                            }
                            <img src="@imgSrc" alt="Foto de @Model.NomeCompleto" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%;" />
                        </div>
                    }

                    <div class="item-info">
                        <div class="w-100">
                            <h4>Dados Pessoais</h4>
                            <hr />
                            <div class="item-detail"><strong>Nome Completo:</strong> @Model.NomeCompleto</div>
                            <div class="item-detail"><strong>CPF:</strong> @Model.Cpf</div>
                            <div class="item-detail"><strong>Data de Nascimento:</strong> @Model.DataNascimento.ToString("dd/MM/yyyy")</div>
                            <div class="item-detail"><strong>Telefone:</strong> @Model.Telefone</div>
                            <div class="item-detail"><strong>Email:</strong> @(Model.Email ?? "Não informado")</div>
                        </div>

                        <div class="w-100 mt-4">
                            <h4>Endereço</h4>
                            <hr />
                            <div class="item-detail"><strong>CEP:</strong> @Model.Cep</div>
                            <div class="item-detail"><strong>Endereço:</strong> @Model.Logradouro - @Model.Bairro</div>
                            <div class="item-detail"><strong>Cidade/Estado:</strong> @Model.Cidade / @Model.Estado</div>

                            <hr />
                            <div class="item-detail">
                                <strong>Restaurante:</strong>
                                @ViewBag.NomeRestaurante
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .item-image {
        margin-bottom: 1rem;
    }

    .item-detail {
        padding-bottom: 0.5rem;
        font-size: 1rem;
    }

    .item-info {
        gap: 0;
    }

    @@media (min-width: 768px) {
        .item-image {
            margin-bottom: 0;
            margin-right: 1.5rem;
        }

        .item-info {
            flex-direction: column;
            align-items: flex-start;
            /* margin-left: 2rem; */
        }
    }
</style>