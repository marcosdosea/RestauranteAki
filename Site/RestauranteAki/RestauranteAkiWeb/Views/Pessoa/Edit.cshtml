@model RestauranteAkiWeb.Models.PessoaViewModel

@{
    ViewData["SubTitle"] = "Editar " + (Model.TipoPessoa == "F" ? "Garçom" : "Gestor");

    var indexAction = Model.TipoPessoa == "F" ? "IndexGarcom" : "IndexGestor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/restaurante-styles.css" />
}

<div class="container-fluid my-5">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="glass-card" data-aos="fade-up">
                <div class="card-header-custom">
                    <div class="logo-box">
                        <i class="fas fa-pencil-alt"></i>
                    </div>
                    <span class="header-title">@ViewData["SubTitle"]</span>
                </div>
                <div class="card-body card-body-custom">

                    <form asp-action="Edit" method="post">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="mb-0">Editando: @Model.NomeCompleto</h4>
                            <div class="d-flex gap-2">
                                <a asp-action="@indexAction" class="btn btn-secondary btn-animated">
                                    <i class="fas fa-arrow-left me-2"></i> Voltar
                                </a>
                                <button type="submit" class="btn btn-green btn-animated">
                                    <i class="fas fa-save me-2"></i> Salvar Alterações
                                </button>
                            </div>
                        </div>
                        <hr />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="TipoPessoa" />


                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NomeCompleto" class="form-label fw-semibold"></label>
                                <input asp-for="NomeCompleto" class="form-control" />
                                <span asp-validation-for="NomeCompleto" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cpf" class="form-label fw-semibold"></label>
                                <input asp-for="Cpf" class="form-control" />
                                <span asp-validation-for="Cpf" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefone" class="form-label fw-semibold"></label>
                                <input asp-for="Telefone" class="form-control" />
                                <span asp-validation-for="Telefone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DataNascimento" class="form-label fw-semibold"></label>
                                <input asp-for="DataNascimento" class="form-control" />
                                <span asp-validation-for="DataNascimento" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdRestaurante" class="form-label fw-semibold"></label>
                                <input asp-for="IdRestaurante" class="form-control" />
                                <span asp-validation-for="IdRestaurante" class="text-danger"></span>
                            </div>
                        </div>

                        <h5 class="mt-4">Endereço</h5>
                        <hr />

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Cep" class="form-label fw-semibold"></label>
                                <input asp-for="Cep" class="form-control" />
                                <span asp-validation-for="Cep" class="text-danger"></span>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label asp-for="Logradouro" class="form-label fw-semibold"></label>
                                <input asp-for="Logradouro" class="form-control" />
                                <span asp-validation-for="Logradouro" class="text-danger"></span>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.body.classList.add('bg-animated');
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}