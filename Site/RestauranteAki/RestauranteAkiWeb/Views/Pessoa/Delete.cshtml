@model RestauranteAkiWeb.Models.PessoaViewModel

@{
    ViewData["Title"] = ViewBag.Title;
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Tem certeza que deseja excluir?');">
                <button type="submit" class="btn btn-danger">Excluir</button>
            </form>
            <div>
                <a asp-action="@ViewBag.CancelAction" class="btn btn-secondary">Cancelar</a>
            </div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">@ViewBag.HeaderText</div>
        <div class="row">
            <div class="col-12">
                <div class="delete-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Atenção!</strong> Você tem certeza que deseja excluir permanentemente o registro abaixo? Esta ação não pode ser desfeita.
                </div>

                <div class="item-card mb-4">
                    @if (Model.Foto == null)
                    {
                        <div class="item-image me-md-4 mb-3 mb-md-0">
                            @{
                                // var base64 = Convert.ToBase64String(Model.Foto);
                                // var imgSrc = $"data:image/jpeg;base64,{base64}";
                                var imgSrc = "/avatar-default.jpg";
                            }
                            <img src="@imgSrc" alt="Foto de @Model.NomeCompleto" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%;" />
                        </div>
                    }
                    <div class="item-info">
                        <div class="item-detail">
                            <strong>Nome:</strong> @Model.NomeCompleto
                        </div>
                        <div class="item-detail">
                            <strong>CPF:</strong> @Model.Cpf
                        </div>
                        <div class="item-detail">
                            <strong>Telefone:</strong> @Model.Telefone
                        </div>
                        <div class="item-detail">
                            <strong>Restaurante:</strong> @ViewBag.NomeRestaurante
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    @@media (min-width: 768px) {
        .item-info {
            flex-direction: column;
            align-items: flex-start;
            /* margin-left: 2rem; */
        }
    }
</style>