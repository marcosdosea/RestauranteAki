@model RestauranteAkiWeb.Models.MesaViewModel

@{
    ViewData["Title"] = "Detalhes da Mesa";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a></div>
            <div><a class="btn btn-secondary" onclick="history.back();">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Mesa</div>
        <div class="row">
            <div class="col-12">
                <div class="item-card">
                    <img class="item-mesa-img"
                         src="@(Model.Imagem != null && Model.Imagem.Length > 0
                                                     ? $"data:image/jpeg;base64,{Convert.ToBase64String(Model.Imagem)}"
                                                     : "/avatar-default.jpg")"
                         alt="Imagem da mesa" />

                    <div class="item-info">
                        <div class="item-mesa-detail">
                            <strong>Id:</strong> @Model.Id
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .item-mesa-img {
        width: 50%;
        height: auto;
        max-width: 160px;
        object-fit: cover;
        border-radius: 0.5rem;
    }

    .item-info {
        align-items: center;
    }

    @@media (min-width: 768px) {
        .item-mesa-img {
            max-width: 240px;
            height: auto;
        }

        .item-info {
            flex-direction: column;
            align-items: flex-start;
            margin-left: 2rem;
        }
    }
</style>
