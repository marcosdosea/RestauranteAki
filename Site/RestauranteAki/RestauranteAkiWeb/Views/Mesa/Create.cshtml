@model RestauranteAkiWeb.Models.MesaViewModel

@{
    ViewData["Title"] = "Nova Mesa";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <div><a class="btn btn-secondary" onclick="history.back();">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Mesa</div>
        <div class="card-list">
            <div class="item-card">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <label asp-for="Imagem"></label>
                        <input asp-for="Imagem" type="file" class="form-control" />
                        <span asp-validation-for="Imagem" class="text-danger"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-success">Salvar</button>
                        <a asp-action="Index" class="btn btn-danger">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

<style>
    .item-card {
        flex-direction: column;
        padding: 1.5rem;
        border-radius: 0.5rem;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        background-color: #fff;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

        .item-card form {
            gap: 0.5rem;
            display: flex;
            flex-direction: column;
        }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
