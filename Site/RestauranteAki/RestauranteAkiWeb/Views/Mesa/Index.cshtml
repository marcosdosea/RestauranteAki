@model IEnumerable<RestauranteAkiWeb.Models.MesaViewModel>

@{
    ViewData["Title"] = "Mesas";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <div><a asp-action="Create" class="btn btn-primary">Adicionar Mesa</a></div>
            <div><a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Lista de Mesas</div>
        <div class="row g-0">
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-12 item-container">
                        <div class="item-card">
                            <div class="item-info">
                                <span class="item-nome">Mesa @item.Id</span>
                            </div>

                            <div class="item-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">Exibir</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Tem certeza que deseja excluir esta mesa?');">
                                    <button type="submit" class="btn btn-danger">Excluir</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-data">Nenhuma mesa cadastrada.</div>
            }
        </div>
    </section>
</div>