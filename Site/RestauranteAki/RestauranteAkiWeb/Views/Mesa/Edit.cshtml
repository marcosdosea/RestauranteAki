@model RestauranteAkiWeb.Models.MesaViewModel

@{
    ViewData["Title"] = "Editar Mesa";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <div><a class="btn btn-secondary" onclick="history.back();">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Mesa</div>
        <div class="row">
            <div class="col-12">
                <div class="item-card-form">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div class="form-group">
                            <label asp-for="Id"></label>
                            <input asp-for="Id" class="form-control" readonly />
                            <span asp-validation-for="Id" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label>Imagem atual</label>
                            <img class="item-mesa-img"
                                 src="@(Model.Imagem != null && Model.Imagem.Length > 0
                                                                     ? $"data:image/jpeg;base64,{Convert.ToBase64String(Model.Imagem)}"
                                                                     : "/avatar-default.jpg")"
                                 alt="Imagem da mesa" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Imagem">Alterar Imagem</label>
                            <input asp-for="Imagem" type="file" class="form-control" />
                            <span asp-validation-for="Imagem" class="text-danger"></span>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-success">Salvar</button>
                            <a asp-action="Index" class="btn btn-danger">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .item-mesa-img {
        width: 50%;
        height: auto;
        max-width: 160px;
        object-fit: cover;
        border: 2px solid var(--bs-primary);
        border-radius: 0.5rem;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
