@model RestauranteAkiWeb.Models.ContumViewModel

@{
    ViewData["Title"] = "Excluir Conta";
}

<h2>Excluir Conta</h2>

<h4>Tem certeza que deseja excluir esta conta?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Id)</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.DataHoraEncerramento)</dt>
    <dd class="col-sm-10">@Model.DataHoraEncerramento.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Valor)</dt>
    <dd class="col-sm-10">@Model.Valor.ToString("C")</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.FormaPagamento)</dt>
    <dd class="col-sm-10">@Model.FormaPagamento</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Status)</dt>
    <dd class="col-sm-10">@(Model.Status == "A" ? "Aberta" : "Fechada")</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.IdMesa)</dt>
    <dd class="col-sm-10">@Model.IdMesa</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
