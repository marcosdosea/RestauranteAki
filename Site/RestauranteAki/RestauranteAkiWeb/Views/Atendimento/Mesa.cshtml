@model RestauranteAkiWeb.Models.ContumViewModel

@{
    ViewData["Title"] = "Atendimento Mesa";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <button id="btnAddPersonagem" class="btn btn-primary">Adicionar Cliente</button>
            <div><a asp-action="Index" class="btn btn-secondary">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Clientes da Mesa @Model.IdMesa</div>
        <div id="personagensContainer" class="personagem-grid">
            @if (Model.Personagems.Any())
            {
                @foreach (var p in Model.Personagems)
                {
                    <div class="personagem-card" id="personagem-@p.Id">
                        <div class="personagem-circle" style="background-color: @p.IdentificadorCor"></div>
                        <div class="personagem-actions">
                            <a href="/Pedido/Create?personagemId=@p.Id" class="btn btn-primary">Novo Pedido</a>
                            <button onclick="removerPersonagem(@p.Id)" class="btn btn-danger">Remover Cliente</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-data">Nenhum personagem nesta mesa.</div>
            }
        </div>
    </section>
</div>

<style>
    .personagem-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 2rem;
        padding: 2rem;
    }

    .personagem-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.5rem;
        border: 1px solid var(--bs-primary);
        border-radius: 0.5rem;
        background: #fff;
        transition: transform 0.2s;
    }

    .personagem-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .personagem-circle {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        margin-bottom: 1rem;
    }

    .personagem-actions {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 1rem;
    }
</style>

@section Scripts {
    <script>
        const idConta = @Model.Id;

        async function adicionarPersonagem() {
            try {
                const response = await fetch(`/api/AtendimentoApi/contas/${idConta}/personagens`, {
                    method: 'POST'
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                const novoPersonagem = await response.json();
                renderizarNovoPersonagem(novoPersonagem);
            } catch (error) {
                console.error('Erro ao adicionar personagem:', error);
            }
        }

        async function removerPersonagem(id) {
            if (!confirm('Deseja realmente remover este personagem?')) return;

            try {
                const response = await fetch(`/api/AtendimentoApi/personagens/${id}`, {
                    method: 'DELETE'
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                document.getElementById(`personagem-${id}`).remove();
            } catch (error) {
                console.error('Erro ao remover personagem:', error);
            }
        }

        function renderizarNovoPersonagem(p) {
            const container = document.getElementById('personagensContainer');

            const noData = container.querySelector('.no-data');
            if (noData) noData.remove();

            const cardHtml = `
                <div class="personagem-card" id="personagem-${p.id}">
                    <div class="personagem-circle" style="background-color: ${p.identificadorCor}"></div>
                    <div class="personagem-actions">
                        <a href="/Pedido/Create?personagemId=${p.id}" class="btn btn-primary">Novo Pedido</a>
                        <button onclick="removerPersonagem(${p.id})" class="btn btn-danger">Remover Cliente</button>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', cardHtml);
        }

        document.getElementById('btnAddPersonagem').addEventListener('click', adicionarPersonagem);
    </script>
}