@model int

@{
    ViewData["Title"] = "Atendimento Mesa";
}

<div>
    <div class="view-header">
        <div class="view-actions">
            <button id="btnAddPersonagem" class="btn btn-primary">Adicionar Personagem</button>
            <div><a asp-action="Index" class="btn btn-secondary">Voltar</a></div>
        </div>
    </div>

    <section class="card-list-section">
        <div class="card-list-header">Personagens da Mesa @Model</div>
        <div id="personagensContainer" class="personagem-grid">
            <!-- Personagens serão carregados via JavaScript -->
        </div>
    </section>
</div>

<style>
    .personagem-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 2rem;
        padding: 2rem;
    }

    .personagem-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.5rem;
        border: 1px solid var(--bs-primary);
        border-radius: 0.5rem;
        background: #fff;
        transition: transform 0.2s;
    }

    .personagem-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .personagem-circle {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        margin-bottom: 1rem;
    }

    .personagem-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
    }
</style>

@section Scripts {
    <script>
        const idMesa = @Model;
        let isInitializing = true;

        async function carregarPersonagens() {
            try {
                const response = await fetch(`/api/AtendimentoApi/mesas/${idMesa}/personagens`);
                const personagens = await response.json();

                if (personagens.length === 0 && isInitializing) {
                    isInitializing = false; // Previne múltiplas inicializações
                    console.log('Criando personagens iniciais...');
                    await criarPersonagensIniciais();
                    return;
                }

                renderizarPersonagens(personagens);
            } catch (error) {
                console.error('Erro ao carregar personagens:', error);
            }
        }

        async function criarPersonagensIniciais() {
            try {
                await Promise.all([
                    adicionarPersonagem(),
                    adicionarPersonagem()
                ]);
                await carregarPersonagens();
            } catch (error) {
                console.error('Erro ao criar personagens iniciais:', error);
                isInitializing = true; // Permite nova tentativa se falhar
            }
        }

        async function adicionarPersonagem() {
            try {
                const response = await fetch(`/api/AtendimentoApi/mesas/${idMesa}/personagens`, {
                    method: 'POST'
                });
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();
                await carregarPersonagens(); // Recarrega a lista após adicionar
                return result;
            } catch (error) {
                console.error('Erro ao adicionar personagem:', error);
            }
        }

        async function removerPersonagem(id) {
            if (!confirm('Deseja realmente remover este personagem?')) return;

            try {
                await fetch(`/api/AtendimentoApi/personagens/${id}`, {
                    method: 'DELETE'
                });
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                await carregarPersonagens();
            } catch (error) {
                console.error('Erro ao remover personagem:', error);
            }
        }

        function renderizarPersonagens(personagens) {
            const container = document.getElementById('personagensContainer');
            if (personagens.length === 0) {
                container.innerHTML = '<div class="no-data">Nenhum personagem nesta mesa.</div>';
                return;
            }

            container.innerHTML = personagens.map(p => `
                <div class="personagem-card">
                    <div class="personagem-circle" style="background-color: ${p.identificadorCor}"></div>
                    <div class="personagem-actions">
                        <a href="/Pedido/Create?personagemId=${p.id}" class="btn btn-primary">Fazer Pedido</a>
                        <button onclick="removerPersonagem(${p.id})" class="btn btn-danger">Remover</button>
                    </div>
                </div>
            `).join('');
        }

        document.getElementById('btnAddPersonagem').addEventListener('click', adicionarPersonagem);
        
        // Carregar personagens ao iniciar a página
        carregarPersonagens();
    </script>
}