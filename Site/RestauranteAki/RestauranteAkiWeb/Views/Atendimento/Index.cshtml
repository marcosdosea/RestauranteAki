@model IEnumerable<RestauranteAkiWeb.Models.MesaViewModel>

@{
    ViewData["Title"] = "Atendimento";
}

<div>
    <section class="card-list-section">
        <div class="card-list-header">Mesas Disponíveis</div>
        <div class="row g-3 p-3">
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-6 col-lg-4">
                        <div class="mesa-card">
                            <div class="mesa-circle"></div>
                            <div class="mesa-info">
                                <span class="mesa-nome">Mesa @item.Id</span>
                            </div>
                            <div class="mesa-actions">
                                <a asp-action="Mesa" asp-route-id="@item.Id" class="btn btn-primary">Atender Mesa</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-data">Nenhuma mesa disponível.</div>
            }
        </div>
    </section>
</div>

<style>
    .mesa-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem;
        border: 1px solid var(--bs-primary);
        border-radius: 0.5rem;
        background: #fff;
        transition: transform 0.2s;
        height: 100%;
    }

    .mesa-circle {
        width: 75%;
        aspect-ratio: 1 / 1;
        height: auto;
        border-radius: 50%;
        background-color: var(--bs-primary);
        margin-bottom: 1rem;
    }

    .mesa-info {
        text-align: center;
        margin-bottom: 1rem;
    }

    .mesa-nome {
        font-size: 1.2rem;
        font-weight: 600;
    }

    .mesa-actions {
        width: 100%;
    }

    .mesa-actions .btn {
        width: 100%;
        min-width: 0;
        padding: 10px;
        font-size: 1rem;
    }

    @@media (min-width: 768px) {
        .mesa-card {
            padding: 1.5rem;
        }

        .mesa-circle {
            width: 120px;
            height: 120px;
        }

        .mesa-nome {
            font-size: 1.5rem;
        }

        .mesa-actions {
            width: auto;
        }

        .mesa-actions .btn {
            width: auto;
            min-width: 150px;
            padding: 12px;
            font-size: 1rem;
        }
    }
</style>