@page
@model ForgotPasswordModel
@{
   
}
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link rel="stylesheet" href="~/css/auth-styles.css" />

<div class="container py-5">
    <h1 class="text-center mb-4 header-title-standalone">@ViewData["Title"]</h1>
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="glass-card" data-aos="fade-up">

                <div class="card-header-custom">
                    <div class="logo-box">R</div>
                    <span class="header-title">estauranteAki</span>
                </div>

                <div class="card-body card-body-custom">
                    <section>
                        <form method="post">
                            <h4 class="text-center">Insira seu e-mail.</h4>
                            <p class="text-center text-muted small mb-4">Enviaremos um link para você resetar sua senha.</p>
                            <hr />
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                <label asp-for="Input.Email" class="form-label"></label>
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                            <button type="submit" class="w-100 btn btn-lg btn-green btn-animated mt-4">
                                <i class="fas fa-paper-plane me-2"></i>Resetar Senha
                            </button>
                        </form>
                        <div class="text-center small mt-4">
                            <p class="mb-1">
                                <a asp-page="./Login" class="auth-link">Voltar para o Login</a>
                            </p>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-12 col-lg-10">
            <div class="social-icons-footer" data-aos="fade-up" data-aos-delay="200">
                <a href="#" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
                <a href="#" class="social-icon"><i class="fab fa-github"></i></a>
                <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                <a href="#" class="social-icon"><i class="fab fa-youtube"></i></a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    <script src="~/js/interactive-animations.js"></script>
    <partial name="_ValidationScriptsPartial" />
}